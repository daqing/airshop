package home

import (
	"github.com/daqing/airshop/app/models"
	"github.com/daqing/airshop/app/views/catalog"
	"github.com/daqing/airshop/app/views/layouts"
)

templ Index(user *models.User, products []*models.Product) {
	@layouts.Storefront(user, "AirShop", "A complete e-commerce system built with Go and Airway.") {
		<style>
			.home-hero { padding: 48px 24px 32px; text-align: center; }
			.home-hero h1 { font-size: clamp(28px, 5vw, 40px); letter-spacing: -1px; margin: 0; }
			.home-hero p { margin: 10px 0 0; color: var(--sf-muted); }
			.home-section { max-width: 1080px; margin: 0 auto; padding: 0 24px 64px; }
			.home-section h2 { font-size: 18px; margin: 0 0 16px; }
			.home-empty { color: var(--sf-muted); padding: 32px 0; text-align: center; }
		</style>
		<section class="home-hero">
			<h1>AirShop</h1>
			<p>Fresh picks from the store</p>
		</section>
		<section class="home-section">
			<h2>Latest products</h2>
			if len(products) == 0 {
				<p class="home-empty">No products yet. Check back soon.</p>
			} else {
				@catalog.Grid(products)
			}
		</section>
	}
}
