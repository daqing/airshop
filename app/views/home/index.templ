package home

import (
	"github.com/daqing/airshop/app/models"
	"github.com/daqing/airshop/app/services"
	"github.com/daqing/airshop/app/views/layouts"
)

templ Index(products []*models.Product) {
	@layouts.Storefront("AirShop", "A complete e-commerce system built with Go and Airway.") {
		<style>
			.home-hero { padding: 48px 24px 32px; text-align: center; }
			.home-hero h1 { font-size: clamp(28px, 5vw, 40px); letter-spacing: -1px; margin: 0; }
			.home-hero p { margin: 10px 0 0; color: var(--sf-muted); }
			.home-section { max-width: 1080px; margin: 0 auto; padding: 0 24px 64px; }
			.home-section h2 { font-size: 18px; margin: 0 0 16px; }
			.product-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 18px; }
			.product-card { border: 1px solid var(--sf-line); border-radius: 10px; overflow: hidden; background: var(--sf-bg); display: block; color: inherit; text-decoration: none; }
			.product-card:hover { border-color: var(--sf-muted); }
			.product-card .thumb { width: 100%; aspect-ratio: 1; object-fit: cover; display: block; background: var(--sf-line); }
			.product-card .body { padding: 10px 12px 14px; }
			.product-card .name { font-size: 14px; font-weight: 600; line-height: 1.4; }
			.product-card .price { margin-top: 6px; font-size: 15px; font-weight: 700; }
			.home-empty { color: var(--sf-muted); padding: 32px 0; text-align: center; }
		</style>
		<section class="home-hero">
			<h1>AirShop</h1>
			<p>Fresh picks from the store</p>
		</section>
		<section class="home-section">
			<h2>Latest products</h2>
			if len(products) == 0 {
				<p class="home-empty">No products yet. Check back soon.</p>
			} else {
				<div class="product-grid">
					for _, p := range products {
						<a class="product-card" href={ templ.URL("/products/" + p.Slug) }>
							if p.MainImage != "" {
								<img class="thumb" src={ templ.URL(services.ProductImageURL(p.MainImage)) } alt={ p.Name }/>
							} else {
								<img class="thumb" src={ templ.URL(placeholderImage()) } alt={ p.Name }/>
							}
							<div class="body">
								<div class="name">{ p.Name }</div>
								<div class="price">{ services.FormatCents(p.PriceCents) }</div>
							</div>
						</a>
					}
				</div>
			}
		</section>
	}
}

func placeholderImage() string {
	return ("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><rect width='200' height='200' fill='%23d8dae0'/></svg>")
}
