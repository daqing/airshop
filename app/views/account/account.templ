package account

import (
	"github.com/daqing/airshop/app/models"
	"github.com/daqing/airshop/app/views/layouts"
)

templ Page(user *models.User) {
	@layouts.Storefront(user, "My account") {
		<style>
			.account-card { max-width: 480px; margin: 48px auto 64px; padding: 28px; border: 1px solid var(--sf-line); border-radius: 12px; }
			.account-card h1 { font-size: 22px; margin: 0 0 16px; }
			.account-row { display: flex; justify-content: space-between; gap: 16px; padding: 10px 0; border-bottom: 1px dashed var(--sf-line); font-size: 14px; }
			.account-row .k { color: var(--sf-muted); }
			.signout-form { margin-top: 20px; }
			.signout-button { padding: 10px 18px; border-radius: 8px; border: 1px solid #b3423a; background: transparent; color: #b3423a; font-size: 14px; cursor: pointer; }
		</style>
		<div class="account-card">
			<h1>My account</h1>
			<div class="account-row"><span class="k">Display name</span><span>{ user.DisplayName }</span></div>
			<div class="account-row"><span class="k">Phone number</span><span>{ user.PhoneNumber }</span></div>
			<div class="account-row"><span class="k">Status</span><span>{ user.Status }</span></div>
			<div class="account-row"><span class="k">Addresses</span><span><a href="/account/addresses">Manage addresses</a></span></div>
			<div class="account-row"><span class="k">Coupons</span><span><a href="/coupons">Coupon center</a></span></div>
			<div class="account-row"><span class="k">Orders</span><span><a href="/orders">My orders</a></span></div>
			<form class="signout-form" method="post" action="/signout">
				<button class="signout-button" type="submit">Sign out</button>
			</form>
		</div>
	}
}
