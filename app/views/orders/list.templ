package orders

import (
	"strconv"

	"github.com/daqing/airshop/app/models"
	"github.com/daqing/airshop/app/services"
	"github.com/daqing/airshop/app/views/layouts"
)

type ListData struct {
	User     *models.User
	Orders   []*models.Order
	Status   string
	Page     int
	TotalPages int
	Total    int64
}

var statusFilters = []string{
	services.OrderStatusPending,
	services.OrderStatusPaid,
	services.OrderStatusShipped,
	services.OrderStatusCompleted,
	services.OrderStatusCancelled,
	services.OrderStatusRefunded,
}

func listURL(status string, page int) string {
	u := "/orders?page=" + strconv.Itoa(page)
	if status != "" {
		u += "&status=" + status
	}
	return u
}

templ List(data ListData) {
	@layouts.Storefront(data.User, "My orders") {
		<style>
			.orders { max-width: 880px; margin: 32px auto 64px; padding: 0 24px; }
			.orders h1 { font-size: 24px; margin: 0 0 16px; }
			.status-chips { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 18px; }
			.status-chip { padding: 6px 14px; border: 1px solid var(--sf-line); border-radius: 999px; font-size: 13px; color: var(--sf-muted); text-decoration: none; }
			.status-chip:hover { color: inherit; }
			.status-chip.active { background: var(--sf-ink); border-color: var(--sf-ink); color: var(--sf-bg); }
			.order-row { display: flex; justify-content: space-between; align-items: center; gap: 12px; border: 1px solid var(--sf-line); border-radius: 10px; padding: 12px 16px; margin-bottom: 10px; }
			.order-row .no { font-weight: 600; font-size: 14px; }
			.order-row .date { font-size: 12px; color: var(--sf-muted); margin-top: 2px; }
			.order-row .right { display: grid; gap: 4px; justify-items: end; }
			.order-status { display: inline-block; font-size: 11px; padding: 2px 10px; border-radius: 999px; background: var(--sf-ink); color: var(--sf-bg); }
			.order-total { font-weight: 700; font-size: 14px; }
			.order-view { font-size: 12px; color: var(--sf-muted); text-decoration: none; }
			.order-view:hover { color: inherit; }
			.orders-empty { color: var(--sf-muted); text-align: center; padding: 40px 0; }
			.pager { display: flex; gap: 12px; align-items: center; margin-top: 16px; font-size: 13px; color: var(--sf-muted); }
			.pager a { padding: 6px 14px; border: 1px solid var(--sf-line); border-radius: 6px; color: inherit; text-decoration: none; }
		</style>
		<div class="orders">
			<h1>My orders</h1>
			<nav class="status-chips" aria-label="Order status">
				<a class="status-chip" href="/orders">All</a>
				for _, s := range statusFilters {
					if data.Status == s {
						<a class="status-chip active" href={ templ.URL(listURL(s, 1)) }>{ s }</a>
					} else {
						<a class="status-chip" href={ templ.URL(listURL(s, 1)) }>{ s }</a>
					}
				}
			</nav>
			if len(data.Orders) == 0 {
				<p class="orders-empty">No orders in this view.</p>
			} else {
				for _, o := range data.Orders {
					<div class="order-row">
						<div>
							<div class="no">{ o.OrderNo }</div>
							<div class="date">{ o.CreatedAt.Format("2006-01-02 15:04") }</div>
						</div>
						<div class="right">
							<span class="order-status">{ o.Status }</span>
							<span class="order-total">{ services.FormatCents(o.TotalCents) }</span>
							<a class="order-view" href={ templ.URL("/orders/" + o.OrderNo) }>View →</a>
						</div>
					</div>
				}
				<div class="pager">
					<span>{ strconv.FormatInt(data.Total, 10) } order(s)</span>
					if data.Page > 1 {
						<a href={ templ.URL(listURL(data.Status, data.Page-1)) }>Prev</a>
					}
					<span>Page { strconv.Itoa(data.Page) } of { strconv.Itoa(data.TotalPages) }</span>
					if data.Page < data.TotalPages {
						<a href={ templ.URL(listURL(data.Status, data.Page+1)) }>Next</a>
					}
				</div>
			}
		</div>
	}
}
