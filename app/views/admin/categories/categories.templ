package categories

import (
	"github.com/daqing/airshop/app/models"
	"github.com/daqing/airshop/app/views/layouts"
)

templ Index(cats []*models.Category, flash string) {
	@layouts.Admin("Categories") {
		<style>
			.adm-table { width: 100%; border-collapse: collapse; font-size: 14px; background: inherit; }
			.adm-table th, .adm-table td { text-align: left; padding: 8px 10px; border-bottom: 1px solid #d8dae0; }
			.adm-actions { display: flex; gap: 8px; }
			.adm-button { display: inline-block; padding: 5px 12px; border: 1px solid #8a8f9c; border-radius: 6px; background: transparent; color: inherit; font-size: 13px; cursor: pointer; text-decoration: none; }
			.adm-button-danger { border-color: #b3423a; color: #b3423a; }
			.adm-flash { padding: 10px 14px; border-radius: 6px; margin-bottom: 16px; background: #f3e6e5; color: #8f2f28; }
			.adm-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
		</style>
		<div class="adm-head">
			<h1>Categories</h1>
			<a class="adm-button" href="/admin/categories/new">New category</a>
		</div>
		if flash != "" {
			<div class="adm-flash">{ flash }</div>
		}
		if len(cats) == 0 {
			<p>No categories yet. Create the first one.</p>
		} else {
			<table class="adm-table">
				<thead>
					<tr><th>Name</th><th>Slug</th><th>Parent</th><th>Sort</th><th>Enabled</th><th></th></tr>
				</thead>
				<tbody>
					for _, c := range cats {
						<tr>
							<td>{ c.Name }</td>
							<td><code>{ c.Slug }</code></td>
							<td>
								if c.ParentID != nil {
									{ parentName(cats, *c.ParentID) }
								} else {
									—
								}
							</td>
							<td>{ fmtInt(c.SortOrder) }</td>
							<td>{ enabledBadge(c.Enabled) }</td>
							<td>
								<div class="adm-actions">
									<a class="adm-button" href={ templ.URL("/admin/categories/" + fmtID(int64(c.ID)) + "/edit") }>Edit</a>
									<form method="post" action={ templ.URL("/admin/categories/" + fmtID(int64(c.ID)) + "/delete") }>
										<button class="adm-button adm-button-danger" type="submit">Delete</button>
									</form>
								</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
	}
}

templ Form(title string, action string, cat *models.Category, parents []*models.Category, errMsg string) {
	@layouts.Admin(title) {
		<style>
			.adm-form { max-width: 480px; display: grid; gap: 14px; }
			.adm-form label { display: grid; gap: 4px; font-size: 13px; font-weight: 600; }
			.adm-form input[type="text"], .adm-form input[type="number"], .adm-form select {
				padding: 8px 10px; border: 1px solid #b8bcc6; border-radius: 6px; font-size: 14px;
			}
			.adm-form .check { display: flex; align-items: center; gap: 8px; }
			.adm-error { padding: 10px 14px; border-radius: 6px; background: #f3e6e5; color: #8f2f28; }
			.adm-button { display: inline-block; padding: 8px 16px; border: 1px solid #8a8f9c; border-radius: 6px; background: transparent; color: inherit; font-size: 14px; cursor: pointer; text-decoration: none; }
		</style>
		<h1>{ title }</h1>
		if errMsg != "" {
			<p class="adm-error">{ errMsg }</p>
		}
		<form class="adm-form" method="post" action={ templ.URL(action) }>
			<label>
				Name
				<input type="text" name="name" value={ formValue(catName(cat)) } required/>
			</label>
			<label>
				Slug
				<input type="text" name="slug" value={ formValue(catSlug(cat)) } required/>
			</label>
			<label>
				Parent
				<select name="parent_id">
					<option value="">— none —</option>
					for _, p := range parents {
						if cat != nil && cat.ParentID != nil && *cat.ParentID == int64(p.ID) {
							<option value={ fmtID(int64(p.ID)) } selected>{ p.Name }</option>
						} else {
							<option value={ fmtID(int64(p.ID)) }>{ p.Name }</option>
						}
					}
				</select>
			</label>
			<label>
				Sort order
				<input type="number" name="sort_order" value={ formValue(catSortOrder(cat)) }/>
			</label>
			<label class="check">
				<input type="checkbox" name="enabled" value="true" checked?={ cat == nil || cat.Enabled }/>
				Enabled
			</label>
			<div>
				<button class="adm-button" type="submit">Save</button>
				<a class="adm-button" href="/admin/categories">Cancel</a>
			</div>
		</form>
	}
}
