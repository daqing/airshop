package admin

import "github.com/daqing/airshop/app/views/layouts"

// Dashboard is the admin landing page. Real metrics arrive with M9 (T9.2);
// until then it is a placeholder listing the upcoming sections.
templ Dashboard() {
	@layouts.Admin("Dashboard") {
		<h1>Dashboard</h1>
		<p>Store overview will land here: orders, sales, and pending work.</p>
		<ul>
			<li><a href="/admin/products">Products</a> — manage catalog (M1)</li>
			<li><a href="/admin/orders">Orders</a> — review and ship orders (M5/M9)</li>
			<li><a href="/admin/coupons">Coupons</a> — create and disable coupons (M7)</li>
		</ul>
	}
}
