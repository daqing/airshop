package admin

import (
	"strconv"

	"github.com/daqing/airshop/app/models"
	"github.com/daqing/airshop/app/services"
	"github.com/daqing/airshop/app/views/layouts"
)

// Dashboard is the admin landing page: live numbers plus shortcuts into the
// management modules.
templ Dashboard(admin *models.AdminUser, stats services.DashboardStats) {
	@layouts.Admin(admin, "Dashboard") {
		<style>
			.dash { max-width: 880px; margin: 32px auto 64px; padding: 0 24px; }
			.dash h1 { font-size: 22px; margin: 0 0 18px; }
			.dash h2 { font-size: 15px; margin: 24px 0 12px; }
			.stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; }
			.stat-card { border: 1px solid #d8dae0; border-radius: 10px; padding: 14px 16px; }
			.stat-card .k { font-size: 12px; color: #6b7280; }
			.stat-card .v { font-size: 22px; font-weight: 700; letter-spacing: -0.5px; margin-top: 4px; }
			.todo-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; }
			.todo-card { border: 1px solid #d8dae0; border-radius: 10px; padding: 14px 16px; display: grid; gap: 4px; }
			.todo-card .n { font-size: 22px; font-weight: 700; }
			.todo-card .k { font-size: 12px; color: #6b7280; }
			.todo-card a { font-size: 12px; }
			.links { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; margin-top: 24px; }
			.links a { border: 1px solid #d8dae0; border-radius: 10px; padding: 12px 16px; font-size: 13px; color: inherit; text-decoration: none; }
			.links a:hover { border-color: #6b7280; }
		</style>
		<div class="dash">
			<h1>Dashboard</h1>
			<h2>Last 7 days</h2>
			<div class="stat-grid">
				<div class="stat-card"><div class="k">Orders (7d)</div><div class="v">{ strconv.FormatInt(stats.OrdersWeek, 10) }</div></div>
				<div class="stat-card"><div class="k">Sales (7d)</div><div class="v">{ services.FormatCents(stats.SalesWeek) }</div></div>
				<div class="stat-card"><div class="k">Orders today</div><div class="v">{ strconv.FormatInt(stats.OrdersToday, 10) }</div></div>
				<div class="stat-card"><div class="k">Sales today</div><div class="v">{ services.FormatCents(stats.SalesToday) }</div></div>
			</div>
			<h2>Pending work</h2>
			<div class="todo-grid">
				<div class="todo-card">
					<span class="n">{ strconv.FormatInt(stats.ToShip, 10) }</span>
					<span class="k">Paid orders to ship</span>
					<a href="/admin/shipments">Ship now →</a>
				</div>
				<div class="todo-card">
					<span class="n">{ strconv.FormatInt(stats.AwaitingPayment, 10) }</span>
					<span class="k">Awaiting payment</span>
					<a href="/orders?status=pending">View orders →</a>
				</div>
				<div class="todo-card">
					<span class="n">{ strconv.FormatInt(stats.Shipped, 10) }</span>
					<span class="k">In transit</span>
					<a href="/admin/shipments">Track →</a>
				</div>
				<div class="todo-card">
					<span class="n">{ strconv.FormatInt(stats.Refunded, 10) }</span>
					<span class="k">Refunded</span>
					<a href="/orders?status=refunded">View →</a>
				</div>
			</div>
			<h2>Manage</h2>
			<div class="links">
				<a href="/admin/categories">Categories</a>
				<a href="/admin/products">Products</a>
				<a href="/admin/coupons">Coupons</a>
				<a href="/admin/shipments">Shipments</a>
			</div>
		</div>
	}
}
