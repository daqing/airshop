package orders

import (
	"strconv"

	"github.com/daqing/airshop/app/models"
	"github.com/daqing/airshop/app/services"
	"github.com/daqing/airshop/app/views/layouts"
)

type ListData struct {
	Admin      *models.AdminUser
	Orders     []*models.Order
	Status     string
	Search     string
	Page       int
	TotalPages int
	Total      int64
}

var adminStatusFilters = []string{
	services.OrderStatusPending,
	services.OrderStatusPaid,
	services.OrderStatusShipped,
	services.OrderStatusCompleted,
	services.OrderStatusCancelled,
	services.OrderStatusRefunded,
}

func listURL(status, search string, page int) string {
	u := "/admin/orders?page=" + strconv.Itoa(page)
	if status != "" {
		u += "&status=" + status
	}
	if search != "" {
		u += "&q=" + search
	}
	return u
}

func orderID(id int64) string {
	return strconv.FormatInt(id, 10)
}

templ List(data ListData) {
	@layouts.Admin(data.Admin, "Orders") {
		<style>
			.ao { max-width: 920px; margin: 32px auto 64px; padding: 0 24px; }
			.ao h1 { font-size: 22px; margin: 0 0 16px; }
			.ao-search { display: flex; gap: 8px; margin-bottom: 14px; }
			.ao-search input { padding: 8px 12px; border: 1px solid #b8bcc6; border-radius: 6px; font-size: 13px; width: 260px; }
			.ao-search button { padding: 8px 14px; border: 1px solid #101319; border-radius: 6px; background: #101319; color: #f3f4ef; font-size: 13px; cursor: pointer; }
			.status-chips { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 16px; }
			.status-chip { padding: 5px 13px; border: 1px solid #b8bcc6; border-radius: 999px; font-size: 12px; color: #4b5563; text-decoration: none; }
			.status-chip.active { background: #101319; border-color: #101319; color: #f3f4ef; }
			.ao-table { width: 100%; border-collapse: collapse; font-size: 13px; }
			.ao-table th, .ao-table td { text-align: left; padding: 8px 10px; border-bottom: 1px solid #d8dae0; }
			.ao-table .no { font-weight: 600; }
			.ao-badge { font-size: 11px; padding: 2px 8px; border-radius: 999px; background: #101319; color: #f3f4ef; }
			.ao-view { font-size: 12px; color: #4b5563; text-decoration: none; }
			.ao-view:hover { color: #101319; }
			.ao-empty { color: #6b7280; text-align: center; padding: 32px 0; }
			.ao-pager { display: flex; gap: 12px; align-items: center; margin-top: 16px; font-size: 13px; color: #6b7280; }
			.ao-pager a { padding: 5px 12px; border: 1px solid #b8bcc6; border-radius: 6px; color: inherit; text-decoration: none; }
		</style>
		<div class="ao">
			<h1>Orders</h1>
			<form class="ao-search" method="get" action="/admin/orders">
				if data.Status != "" {
					<input type="hidden" name="status" value={ data.Status }/>
				}
				<input type="text" name="q" placeholder="Search order number" value={ data.Search }/>
				<button type="submit">Search</button>
			</form>
			<nav class="status-chips">
				<a class="status-chip" href="/admin/orders">All</a>
				for _, s := range adminStatusFilters {
					if data.Status == s {
						<a class="status-chip active" href={ templ.URL(listURL(s, data.Search, 1)) }>{ s }</a>
					} else {
						<a class="status-chip" href={ templ.URL(listURL(s, data.Search, 1)) }>{ s }</a>
					}
				}
			</nav>
			if len(data.Orders) == 0 {
				<p class="ao-empty">No orders match.</p>
			} else {
				<table class="ao-table">
					<thead>
						<tr><th>Order</th><th>Created</th><th>Total</th><th>Status</th><th></th></tr>
					</thead>
					<tbody>
						for _, o := range data.Orders {
							<tr>
								<td class="no">{ o.OrderNo }</td>
								<td>{ o.CreatedAt.Format("2006-01-02 15:04") }</td>
								<td>{ services.FormatCents(o.TotalCents) }</td>
								<td><span class="ao-badge">{ o.Status }</span></td>
								<td><a class="ao-view" href={ templ.URL("/admin/orders/" + o.OrderNo) }>View →</a></td>
							</tr>
						}
					</tbody>
				</table>
				<div class="ao-pager">
					<span>{ strconv.FormatInt(data.Total, 10) } order(s)</span>
					if data.Page > 1 {
						<a href={ templ.URL(listURL(data.Status, data.Search, data.Page-1)) }>Prev</a>
					}
					<span>Page { strconv.Itoa(data.Page) } of { strconv.Itoa(data.TotalPages) }</span>
					if data.Page < data.TotalPages {
						<a href={ templ.URL(listURL(data.Status, data.Search, data.Page+1)) }>Next</a>
					}
				</div>
			}
		</div>
	}
}

type DetailData struct {
	Admin    *models.AdminUser
	Order    *models.Order
	Items    []*models.OrderItem
	Flash    string
	Tracking string
}

func refundable(status string) bool {
	return status == services.OrderStatusPaid ||
		status == services.OrderStatusShipped ||
		status == services.OrderStatusCompleted
}

templ Detail(data DetailData) {
	@layouts.Admin(data.Admin, "Order "+data.Order.OrderNo) {
		<style>
			.aod { max-width: 760px; margin: 32px auto 64px; padding: 0 24px; display: grid; gap: 18px; }
			.aod h1 { font-size: 20px; margin: 0; }
			.aod-flash { padding: 10px 14px; border-radius: 8px; background: #f3e6e5; color: #8f2f28; font-size: 13px; }
			.aod-box { border: 1px solid #d8dae0; border-radius: 10px; padding: 16px 18px; }
			.aod-box h2 { font-size: 14px; margin: 0 0 12px; }
			.aod-kv { display: grid; gap: 6px; font-size: 13px; }
			.aod-kv .k { color: #6b7280; }
			.aod-badge { font-size: 12px; padding: 3px 10px; border-radius: 999px; background: #101319; color: #f3f4ef; }
			.aod-line { display: flex; justify-content: space-between; gap: 12px; font-size: 13px; padding: 6px 0; border-bottom: 1px dashed #d8dae0; }
			.aod-line:last-child { border-bottom: 0; }
			.aod-total { display: flex; justify-content: flex-end; gap: 14px; font-weight: 700; padding-top: 8px; }
			.aod-actions { display: flex; gap: 10px; align-items: center; }
			.aod-refund { padding: 9px 18px; border-radius: 8px; border: 1px solid #b3423a; background: transparent; color: #b3423a; font-size: 13px; cursor: pointer; }
			.aod-link { font-size: 13px; color: #4b5563; text-decoration: none; border: 1px solid #b8bcc6; border-radius: 8px; padding: 9px 16px; }
		</style>
		<div class="aod">
			<h1>Order { data.Order.OrderNo }</h1>
			if data.Flash != "" {
				<div class="aod-flash">{ data.Flash }</div>
			}
			<div class="aod-box">
				<h2>Summary</h2>
				<div class="aod-kv">
					<span><span class="aod-badge">{ data.Order.Status }</span></span>
					<span><span class="k">Placed: </span>{ data.Order.CreatedAt.Format("2006-01-02 15:04") }</span>
					<span><span class="k">Payment: </span>{ data.Order.PaymentMethod }</span>
				</div>
			</div>
			<div class="aod-box">
				<h2>Items</h2>
				for _, item := range data.Items {
					<div class="aod-line">
						<span>
							{ item.ProductName }
							if item.VariantName != "" {
								{ " (" }{ item.VariantName }{ ")" }
							}
							{ " × " }{ strconv.Itoa(item.Quantity) }
						</span>
						<span class="sum">{ services.FormatCents(item.UnitPriceCents * int64(item.Quantity)) }</span>
					</div>
				}
				<div class="aod-total">
					<span>Total</span>
					<span>{ services.FormatCents(data.Order.TotalCents) }</span>
				</div>
			</div>
			<div class="aod-box">
				<h2>Shipping</h2>
				<div class="aod-kv">
					<span><span class="k">Recipient: </span>{ data.Order.ShipRecipient } · { data.Order.ShipPhone }</span>
					<span><span class="k">Address: </span>{ data.Order.ShipAddress }</span>
				</div>
			</div>
			if data.Tracking != "" {
				<div class="aod-box">
					<h2>Tracking</h2>
					<div class="aod-kv">{ data.Tracking }</div>
				</div>
			}
			<div class="aod-actions">
				if data.Order.Status == "paid" {
					<a class="aod-link" href="/admin/shipments">Ship via shipments →</a>
				}
				if refundable(data.Order.Status) {
					<form method="post" action={ templ.URL("/admin/orders/" + data.Order.OrderNo + "/refund") }>
						<button class="aod-refund" type="submit">Mark refunded</button>
					</form>
				}
			</div>
		</div>
	}
}
