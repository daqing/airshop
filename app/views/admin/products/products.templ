package products

import (
	"strconv"

	"github.com/daqing/airshop/app/models"
	"github.com/daqing/airshop/app/services"
	"github.com/daqing/airshop/app/views/layouts"
)

type IndexData struct {
	Products   []*models.Product
	Categories []*models.Category
	Query      string
	Status     string
	Page       int
	TotalPages int
	Total      int64
	Flash      string
}

func categoryName(cats []*models.Category, id int64) string {
	for _, c := range cats {
		if int64(c.ID) == id {
			return c.Name
		}
	}
	return "—"
}

func fmtID(id int64) string {
	return strconv.FormatInt(id, 10)
}

func indexURL(query, status string, page int) string {
	u := "/admin/products?page=" + strconv.Itoa(page)
	if query != "" {
		u += "&q=" + query
	}
	if status != "" {
		u += "&status=" + status
	}
	return u
}

templ Index(data IndexData) {
	@layouts.Admin("Products") {
		<style>
			.adm-table { width: 100%; border-collapse: collapse; font-size: 14px; }
			.adm-table th, .adm-table td { text-align: left; padding: 8px 10px; border-bottom: 1px solid #d8dae0; }
			.adm-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
			.adm-button { display: inline-block; padding: 5px 12px; border: 1px solid #8a8f9c; border-radius: 6px; background: transparent; color: inherit; font-size: 13px; cursor: pointer; text-decoration: none; }
			.adm-button-danger { border-color: #b3423a; color: #b3423a; }
			.adm-flash { padding: 10px 14px; border-radius: 6px; margin-bottom: 16px; background: #f3e6e5; color: #8f2f28; }
			.adm-filter { display: flex; gap: 10px; margin-bottom: 16px; align-items: center; }
			.adm-filter input, .adm-filter select { padding: 6px 8px; border: 1px solid #b8bcc6; border-radius: 6px; font-size: 13px; }
			.adm-pager { display: flex; gap: 12px; align-items: center; margin-top: 16px; font-size: 13px; }
		</style>
		<div class="adm-head">
			<h1>Products</h1>
			<a class="adm-button" href="/admin/products/new">New product</a>
		</div>
		if data.Flash != "" {
			<div class="adm-flash">{ data.Flash }</div>
		}
		<form class="adm-filter" method="get" action="/admin/products">
			<input type="text" name="q" placeholder="Search by name" value={ data.Query }/>
			<select name="status">
				<option value="">All statuses</option>
				if data.Status == "active" {
					<option value="active" selected>Active</option>
				} else {
					<option value="active">Active</option>
				}
				if data.Status == "inactive" {
					<option value="inactive" selected>Inactive</option>
				} else {
					<option value="inactive">Inactive</option>
				}
			</select>
			<button class="adm-button" type="submit">Filter</button>
		</form>
		if len(data.Products) == 0 {
			<p>No products match.</p>
		} else {
			<table class="adm-table">
				<thead>
					<tr><th>Name</th><th>Slug</th><th>Category</th><th>Price</th><th>Stock</th><th>Status</th><th></th></tr>
				</thead>
				<tbody>
					for _, p := range data.Products {
						<tr>
							<td>{ p.Name }</td>
							<td><code>{ p.Slug }</code></td>
							<td>
								if p.CategoryID != nil {
									{ categoryName(data.Categories, *p.CategoryID) }
								} else {
									—
								}
							</td>
							<td>{ services.FormatCents(p.PriceCents) }</td>
							<td>{ strconv.Itoa(p.Stock) }</td>
							<td>
								if p.Active {
									active
								} else {
									inactive
								}
							</td>
							<td>
								<div style="display: flex; gap: 8px;">
									<a class="adm-button" href={ templ.URL("/admin/products/" + fmtID(int64(p.ID)) + "/edit") }>Edit</a>
									if p.Active {
										<form method="post" action={ templ.URL("/admin/products/" + fmtID(int64(p.ID)) + "/deactivate") }>
											<button class="adm-button" type="submit">Deactivate</button>
										</form>
									} else {
										<form method="post" action={ templ.URL("/admin/products/" + fmtID(int64(p.ID)) + "/activate") }>
											<button class="adm-button" type="submit">Activate</button>
										</form>
									}
								</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
			<div class="adm-pager">
				<span>{ strconv.FormatInt(data.Total, 10) } product(s)</span>
				if data.Page > 1 {
									<a class="adm-button" href={ templ.URL(indexURL(data.Query, data.Status, data.Page-1)) }>Prev</a>
				}
				<span>Page { strconv.Itoa(data.Page) } of { strconv.Itoa(data.TotalPages) }</span>
				if data.Page < data.TotalPages {
									<a class="adm-button" href={ templ.URL(indexURL(data.Query, data.Status, data.Page+1)) }>Next</a>
				}
			</div>
		}
	}
}

templ Form(title string, action string, p *models.Product, cats []*models.Category, errMsg string) {
	@layouts.Admin(title) {
		<style>
			.adm-form { max-width: 520px; display: grid; gap: 14px; }
			.adm-form label { display: grid; gap: 4px; font-size: 13px; font-weight: 600; }
			.adm-form input[type="text"], .adm-form input[type="number"], .adm-form select, .adm-form textarea {
				padding: 8px 10px; border: 1px solid #b8bcc6; border-radius: 6px; font-size: 14px; font-weight: 400;
			}
			.adm-form .check { display: flex; align-items: center; gap: 8px; }
			.adm-error { padding: 10px 14px; border-radius: 6px; background: #f3e6e5; color: #8f2f28; }
			.adm-button { display: inline-block; padding: 8px 16px; border: 1px solid #8a8f9c; border-radius: 6px; background: transparent; color: inherit; font-size: 14px; cursor: pointer; text-decoration: none; }
		</style>
		<h1>{ title }</h1>
		if errMsg != "" {
			<p class="adm-error">{ errMsg }</p>
		}
		<form class="adm-form" method="post" action={ templ.URL(action) }>
			<label>
				Name
				<input type="text" name="name" value={ productName(p) } required/>
			</label>
			<label>
				Slug (auto-generated from name when left blank)
				<input type="text" name="slug" value={ productSlug(p) }/>
			</label>
			<label>
				Category
				<select name="category_id">
					<option value="">— none —</option>
					for _, cat := range cats {
						if p != nil && p.CategoryID != nil && *p.CategoryID == int64(cat.ID) {
							<option value={ fmtID(int64(cat.ID)) } selected>{ cat.Name }</option>
						} else {
							<option value={ fmtID(int64(cat.ID)) }>{ cat.Name }</option>
						}
					}
				</select>
			</label>
			<label>
				Price
				<input type="text" name="price" value={ productPrice(p) } required/>
			</label>
			<label>
				Stock
				<input type="number" name="stock" value={ productStock(p) } required/>
			</label>
			<label>
				Description
				<textarea name="description" rows="4">{ productDescription(p) }</textarea>
			</label>
			<label>
				Main image (storage key, upload arrives in T1.7)
				<input type="text" name="main_image" value={ productMainImage(p) }/>
			</label>
			<label class="check">
				<input type="checkbox" name="active" value="true" checked?={ p == nil || p.Active }/>
				Active (visible on the storefront)
			</label>
			<div>
				<button class="adm-button" type="submit">Save</button>
				<a class="adm-button" href="/admin/products">Cancel</a>
			</div>
		</form>
	}
}

func productName(p *models.Product) string {
	if p == nil {
		return ""
	}
	return p.Name
}

func productSlug(p *models.Product) string {
	if p == nil {
		return ""
	}
	return p.Slug
}

func productPrice(p *models.Product) string {
	if p == nil {
		return ""
	}
	return services.FormatCents(p.PriceCents)
}

func productStock(p *models.Product) string {
	if p == nil {
		return "0"
	}
	return strconv.Itoa(p.Stock)
}

func productDescription(p *models.Product) string {
	if p == nil {
		return ""
	}
	return p.Description
}

func productMainImage(p *models.Product) string {
	if p == nil {
		return ""
	}
	return p.MainImage
}
